{
  "yfetch": {
    "version": "1.0",
    "description": "yfetch is a Python CLI tool for outputting basic system information to your terminal.",
    "source": {
      "url": "http://localhost:8000/packages/yfetch.tar.gz",
      "build_steps": [
        "chmod +x yfetch.py",
        "mkdir -p /home/yodazf/.local/bin",
        "cp yfetch.py /home/yodazf/.local/bin/yfetch",
        "cp -r logos.py /home/yodazf/.local/bin/"
      ]
    },
    "binary": {
      "url": "http://localhost:8000/packages/yfetch.tar.gz"
    }
  }
}
